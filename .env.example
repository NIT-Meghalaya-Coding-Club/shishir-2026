MONGODB_URI=SHISHIR_MONGO_URI

#NEXT AUTH
NEXTAUTH_URL=SHISHIR_URL
NEXTAUTH_SECRET=YOUR_SECRET

# Google
GOOGLE_CLIENT_ID=SHISHIR_GOOGLE_ID
GOOGLE_CLIENT_SECRET=SHISHIR_GOOGLE_SECRET

#JWT
JWT_SECRET=YOUR_JWT_SECRET

# Comma-separated Google account emails allowed to create new events.
# These users can create events and add multiple event heads.
NEXT_PUBLIC_EVENT_CREATOR_EMAILS=head1@example.com,head2@example.com
NEXT_PUBLIC_COMMITTEE_HEAD_EMAILS=head1@example.com,head2@example.com

# Cloudflare R2 poster uploads
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=YOUR_R2_BUCKET_NAME
R2_PUBLIC_BASE_URL=https://cdn.example.com

NEXT_PUBLIC_POSTER_MAX_SIZE_MB=2
NEXT_PUBLIC_PROFILE_MAX_SIZE_MB=1